# Server Configuration
PORT=3000

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=carrot_ai

# JWT Authentication Secret Key
JWT_SECRET=carrot_ai_super_secret_jwt_key

# Local AI Engine Configuration (Ollama / LM Studio / Jan / llama.cpp)
LOCAL_AI_BASE_URL=http://localhost:11434/v1

# Cloud AI Provider API Keys
# Get key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Get key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Get key from https://platform.moonshot.cn/
KIMI_API_KEY=

# Get key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Get 100% free key from https://console.groq.com/keys
GROQ_API_KEY=

# Default Active Model ID
DEFAULT_MODEL=local-llama3.1
