# Server Configuration
PORT=3000
REQUEST_BODY_LIMIT=15mb
# Explicit origins remain supported. Browser origins on this host's detected
# IPv4 LAN subnets are also allowed dynamically (no gateway/IP hard-coding).
CORS_ORIGINS=http://localhost:4200
# Comma-separated trusted hosts for Ollama/compatible local servers.
LOCAL_AI_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=carrot_ai

# Optional retrieval cache. The backend continues with PostgreSQL if Redis is unavailable.
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=1500
REDIS_RETRY_BASE_MS=250
REDIS_RETRY_MAX_MS=10000
INGESTION_CONCURRENCY=2
INGESTION_MAX_ATTEMPTS=3
INGESTION_RETRY_BASE_MS=1000
SITEMAP_MAX_PAGES=10
RAG_CACHE_TTL_SECONDS=1800
RAG_EMBEDDING_CACHE_TTL_SECONDS=86400

# JWT Authentication Secret Key
JWT_SECRET=carrot_ai_super_secret_jwt_key

# Local AI Engine Configuration (Ollama / LM Studio / Jan / llama.cpp)
LOCAL_AI_BASE_URL=http://localhost:11434/v1

# Cloud AI Provider API Keys
# Get key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Get key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Get key from https://platform.moonshot.cn/
KIMI_API_KEY=

# Get key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Get 100% free key from https://console.groq.com/keys
GROQ_API_KEY=

# Default Active Model ID
DEFAULT_MODEL=local:reecdev/qwen3.5-lowvram:9b
